# =====================================================================
# paycheck-bot configuration. Copy this file to ".env" and fill it in.
# NEVER commit the real .env file (it is in .gitignore).
# Lines starting with # are comments. Don't put quotes around values.
# =====================================================================

# ---------- Discord ----------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Your own Discord user ID (Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID).
# The bot ignores everyone else.
ALLOWED_USER_ID=
# Optional: channel ID where automatic alerts are posted. Leave blank to get alerts by DM.
ALERT_CHANNEL_ID=

# ---------- Actual Budget ----------
# Use the NAS LAN IP and Actual's port, not "localhost" (inside Docker, localhost is the bot itself).
ACTUAL_URL=http://192.168.1.50:5006
ACTUAL_PASSWORD=
# Budget name, or the Sync ID (Actual -> Settings -> Advanced settings -> Sync ID)
ACTUAL_FILE=My Budget
# Only if you enabled end-to-end encryption on the budget. Otherwise leave blank.
ACTUAL_ENCRYPTION_PASSWORD=
# Case-insensitive text that appears in the payee name of your paycheck deposits (e.g. "ACME CORP")
PAYEE_MATCH=
# Optional: only look at deposits in this Actual account name. Blank = all accounts.
ACTUAL_ACCOUNT=
# How many days either side of payday to look for the deposit
DEPOSIT_WINDOW_DAYS=3
# If your direct deposit is split across accounts, "sum" adds the matching deposits together
# (use this if the NET you want to verify is the total). "largest" uses only the biggest deposit.
DEPOSIT_MODE=sum

# ---------- Pay schedule ----------
# Any ONE past payday, as YYYY-MM-DD. Every other payday is calculated from it (every 14 days).
PAY_ANCHOR_DATE=2026-10-09
# Days between the END of the pay period and the payday.
# Example: period ends Saturday, you are paid Friday of the next week => 6.
# The weekday your work weeks end on is derived from this (payday minus this many days).
PAY_LAG_DAYS=6
# Timezone (IANA name)
TZ=America/New_York

# ---------- Pay rules ----------
HOURLY_RATE=30.00
OT_MULTIPLIER=1.5
# If you send ONE number (e.g. "43"), hours above this are treated as overtime.
# Set to 0 to treat a single number as regular hours only.
WEEKLY_OT_THRESHOLD=40
# Flat extra taxable pay each pay period (shift differential, stipend...). Usually 0.
EXTRA_PAY_PER_PERIOD=0

# ---------- Net pay prediction ----------
# "deduction" (more accurate) or "ratio" (simplest)
CALC_MODE=deduction

# --- ratio mode: net divided by gross, from past stubs (e.g. 1180 / 1500 = 0.787)
NET_RATIO=0.78

# --- deduction mode: per PAYCHECK amounts and rates, taken from your stub
# Pre-tax health/dental/vision (Section 125) in dollars per paycheck
HEALTH_PRETAX=0
# 401k contribution as a fraction of gross (5% = 0.05)
K401_PCT=0.0
# true if your 401k is Roth (it then does NOT reduce taxable income)
K401_ROTH=false
# Post-tax deductions in dollars per paycheck (union dues, garnishments, Roth IRA, etc.)
OTHER_POSTTAX=0
# Social Security + Medicare
FICA_RATE=0.0765
# (federal + state + local income tax withheld) / (gross - pretax deductions).
# Use `python -m app.calibrate` with numbers from one stub to compute this.
EFFECTIVE_TAX_RATE=0.16

# ---------- Tolerances ----------
# Net deposit may differ from the expected amount by this many dollars and still count as OK
TOLERANCE_DOLLARS=5.00
# Gross from the stub vs gross computed from your hours
STUB_GROSS_TOLERANCE=1.00
# Stub net vs the deposit in Actual (should be exact; allow a cent or two)
STUB_NET_TOLERANCE=0.02

# ---------- Automatic checks and reminders ----------
AUTO_CHECK_ENABLED=true
# Local time (24h HH:MM) the daily automatic check runs
AUTO_CHECK_TIME=09:00
# Wait this many days after payday before checking (bank sync lag)
DEPOSIT_DELAY_DAYS=1
# If no deposit is found by this many days after payday, alert you about it
DEPOSIT_GIVE_UP_DAYS=5
REMINDER_ENABLED=true
REMINDER_TIME=18:00
# 0 = remind on the day your week ends, -1 = the day before (e.g. Friday if the week ends Saturday)
REMINDER_OFFSET_DAYS=0
# Which week a plain hours message applies to:
#   current  = the week that ends on or after today (send hours at the end of the week)
#   previous = the most recent week that has already ended
# You can always override: "40 0 ending 10/03"
DEFAULT_WEEK=current

# ---------- Paystub PDFs (optional; works with ADP stubs) ----------
# Inside the container this should stay /data/paystubs
STUB_DIR=/data/paystubs
# Regexes (Python syntax) with ONE capture group. Run `python -m app.paystub yourstub.pdf` to test.
STUB_GROSS_REGEX=Gross Pay[^\d\-]*\$?\s*([\d,]+\.\d{2})
STUB_NET_REGEX=Net Pay[^\d\-]*\$?\s*([\d,]+\.\d{2})
STUB_DATE_REGEX=Pay Date:?\s*(\d{1,2}/\d{1,2}/\d{4})
STUB_DATE_FORMAT=%m/%d/%Y

# ---------- Local LLM (optional) ----------
# false = plain parser only (recommended to start). true = ask Ollama to parse your message first,
# falling back to the plain parser if Ollama is unreachable.
USE_LLM=false
OLLAMA_URL=http://192.168.1.60:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=60

# ---------- Storage ----------
# Inside the container leave as /data (mapped to a TrueNAS dataset in docker-compose.yml)
DATA_DIR=/data
